      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const identity=$(\"Validate Rate Check\").first().json.data;const now=Date.now();const raw=$input.all().map(x=>x.json);if(raw.length>=1000)return [{json:{success:true,retryAfter:60}}];const rows=raw.filter(x=>Number.isFinite(x.created_ms)&&x.created_ms>now-900000);const success=rows.filter(x=>x.successful);const lastAccount=Math.max(0,...success.filter(x=>x.account_hash===identity.account).map(x=>x.created_ms));const lastPair=Math.max(0,...success.filter(x=>x.account_hash===identity.account&&x.ip_hash===identity.ip).map(x=>x.created_ms));const failures=rows.filter(x=>!x.successful);const pair=failures.filter(x=>x.account_hash===identity.account&&x.ip_hash===identity.ip&&x.created_ms>lastPair);const ip=failures.filter(x=>x.ip_hash===identity.ip);const account=failures.filter(x=>x.account_hash===identity.account&&x.created_ms>lastAccount);function next(items,free){return items.length<=free?0:Math.max(...items.map(x=>x.created_ms))+Math.min(60000,1000*2**Math.min(items.length-free-1,6));}const retryAfter=Math.max(0,Math.min(60,Math.ceil((Math.max(next(pair,0),next(ip,20),next(account,30))-now)/1000)));return [{json:{success:true,retryAfter}}];"
