{
  "name": "DrivePilot - Send mail",
  "nodes": [
    {
      "name": "Webhook Send Mail",
      "id": "webhook-send-mail",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "api/mail/send",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "position": [
        0,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "DrivePilot Header Auth"
        }
      }
    },
    {
      "name": "Validate Send Mail",
      "id": "validate-send-mail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Seul le serveur DrivePilot (jeton) appelle ce webhook ; on revalide quand même : destinataire unique, pas d'en-têtes injectés.\nconst input = $input.first().json;\nfunction ok(body) {\n  if (!body || typeof body !== 'object' || Array.isArray(body)) return false;\n  const keys = Object.keys(body);\n  if (keys.length !== 3 || !['to','subject','text'].every(k => keys.includes(k))) return false;\n  const { to, subject, text } = body;\n  if (typeof to !== 'string' || to.length > 254 || !/^[^\\s@,;<>]+@[^\\s@,;<>]+\\.[^\\s@,;<>]+$/.test(to)) return false;\n  if (typeof subject !== 'string' || !subject.trim() || subject.length > 150 || /[\\r\\n]/.test(subject)) return false;\n  if (typeof text !== 'string' || !text.trim() || text.length > 5000) return false;\n  return true;\n}\nconst q = input.query ?? {};\nif (Object.keys(q).length || !ok(input.body)) return [{json:{valid:false}}];\nreturn [{json:{valid:true,data:{to:input.body.to.trim().toLowerCase(),subject:input.body.subject,text:input.body.text}}}];"
      },
      "position": [
        220,
        0
      ]
    },
    {
      "name": "Valid Send Mail",
      "id": "valid-send-mail",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        440,
        0
      ]
    },
    {
      "name": "Bad Send Mail",
      "id": "bad-send-mail",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { error: \"Entrée invalide.\" } }}",
        "options": {
          "responseCode": 400
        }
      },
      "position": [
        660,
        160
      ]
    },
    {
      "id": "send-mail",
      "name": "Send Mail",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        660,
        0
      ],
      "parameters": {
        "fromEmail": "DrivePilot <noreply@partageons.net>",
        "toEmail": "={{ $json.data.to }}",
        "subject": "={{ $json.data.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.data.text }}",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "smtp": {
          "name": "DrivePilot SMTP"
        }
      }
    },
    {
      "name": "Respond Send Mail",
      "id": "respond-send-mail",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ ({success:true}) }}",
        "options": {
          "responseCode": 200
        }
      },
      "position": [
        880,
        0
      ]
    }
  ],
  "connections": {
    "Webhook Send Mail": {
      "main": [
        [
          {
            "node": "Validate Send Mail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Send Mail": {
      "main": [
        [
          {
            "node": "Valid Send Mail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Valid Send Mail": {
      "main": [
        [
          {
            "node": "Send Mail",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Bad Send Mail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Mail": {
      "main": [
        [
          {
            "node": "Respond Send Mail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
